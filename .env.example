# ---- Required ----
# Public URL users open in the browser (no trailing slash). Local: http://localhost:3006
PUBLIC_URL=http://localhost:3006
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# 32 random bytes, base64: openssl rand -base64 32   (losing it makes stored AI/Google keys unreadable)
APP_ENCRYPTION_KEY=
# Comma-separated emails that get the admin role when they sign up / sign in
ADMIN_EMAILS=

# ---- Optional: Google sign-in + Drive sheet sync ----
# Web application OAuth client. Authorized redirect URIs:
#   ${PUBLIC_URL}/api/auth/google/callback
#   ${PUBLIC_URL}/api/google/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Worker / login browser ----
MAX_CONCURRENT_RUNS=3
MAX_LOGIN_SESSIONS=3

# ---- Production only (docker-compose.prod.yml) ----
# On the VPS this file is created and maintained by deploy/remote-deploy.sh (see README → Deploy).
# PUBLIC_URL=https://job-crawler.educoreva.com
# IMAGE_PREFIX=ghcr.io/<github-user>/job-crawler
# IMAGE_TAG=<git sha of the running release>
# MONGO_ROOT_USER=jobcrawler
# MONGO_ROOT_PASSWORD=   # openssl rand -hex 24 (keep it URL-safe)
# TRUST_PROXY_HOPS=2     # edge nginx + Caddy in front of the API
# BACKUP_KEEP_DAYS=14
