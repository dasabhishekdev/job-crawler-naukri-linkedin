MONGODB_URI=mongodb://mongodb:27017/jobportal
API_PORT=4000
TARGET_FRESH_JOBS=20
MAX_JOB_AGE_DAYS=14
TIER1_MIN_SCORE=5
TIER2_MIN_SCORE=1
MAX_AUTO_APPLY_PER_RUN=10
AUTO_APPLY_ENABLED=true
AGENT_SCHEDULE_ENABLED=true
HEADLESS=true
RESUME_DIR=/app/resume/anika
RESUME_ROOT=/app/resume
DATA_DIR=/app/data
PROFILE_PATH=/app/config/profile.json
JOBHUNTER_DB_PATH=/app/linkedin-cli/jobs.db
NAUKRI_STORAGE_STATE=/app/data/naukri-storage-state.json
NAUKRI_LOCATION=bengaluru
NAUKRI_EXPERIENCE=2
NAUKRI_KEYWORDS=supply chain|operations analyst|logistics analyst|warehouse operations|quick commerce|line haul|fleet management
VNC_PUBLIC_URL=http://localhost:6080/vnc.html
# LAN access: open http://<your-mac-ip>:3001 from phones/laptops on the same Wi-Fi.
# API/VNC URLs auto-use the host you browse from (no rebuild needed). Find IP: ipconfig getifaddr en0
AUTH_BROWSER_URL=http://auth-browser:5000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Cursor SDK agent that web-searches any job site / career page (cursor.com/dashboard/integrations)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Google OAuth web client for Drive + Sheets (see README "Google Drive setup")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/oauth/callback
WEB_PUBLIC_URL=http://localhost:3006
LINKEDIN_LOCATION=Bangalore, Karnataka, India
LINKEDIN_KEYWORDS=operations analyst logistics|supply chain analyst bangalore|procurement analyst|warehouse operations analyst
